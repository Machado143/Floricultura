{
  "name": "floraerp",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão para floricultura",
  "main": "server.js",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema server/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "seed": "node server/prisma/seed.js",
    "test": "node --test \"server/**/*.test.js\" \"client/services/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "node server/prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
