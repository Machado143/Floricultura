generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
}

enum CategoriaProduto {
  PLANTA
  VASO
  INSUMO
  ARRANJO
  OUTROS
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

enum StatusPedido {
  CONCLUIDO
  CANCELADO
}

enum MotivoPerda {
  DETERIORACAO
  AVARIA
  PRAGA
  VALIDADE
  OUTROS
}

enum StatusEntrega {
  PENDENTE
  EM_PREPARACAO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  ativo     Boolean  @default(true)
  role      Role     @default(VENDEDOR)
  pedidos   Pedido[]
  perdas    Perda[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  cpfCnpj   String?  @unique
  email     String?
  telefone  String?
  endereco  String?
  pedidos   Pedido[]
  entregas  Entrega[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clientes")
}

model Produto {
  id                 String           @id @default(cuid())
  nome               String
  sku                String           @unique
  categoria          CategoriaProduto
  precoVenda         Decimal          @db.Decimal(10, 2)
  quantidadeEstoque  Int              @default(0)
  popular            Boolean          @default(false)
  descricao          String?
  imagemUrl          String?
  rega               String?
  iluminacao         String?
  cuidados           String?
  usos               String?
  argumentosVenda    String?
  sugestoesIds       String?
  ativo              Boolean          @default(true)
  itensPedido        ItemPedido[]
  perdas             Perda[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Pedido {
  id              String         @id @default(uuid()) @db.Uuid
  usuarioId       String
  clienteId       String?
  valorTotal      Decimal        @db.Decimal(10, 2)
  desconto        Decimal        @default(0) @db.Decimal(10, 2)
  troco           Decimal        @default(0) @db.Decimal(10, 2)
  formaPagamento  FormaPagamento
  status          StatusPedido   @default(CONCLUIDO)
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  cliente         Cliente?       @relation(fields: [clienteId], references: [id])
  entrega         Entrega?
  itens           ItemPedido[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([usuarioId])
}

model ItemPedido {
  id             String   @id @default(uuid()) @db.Uuid
  pedidoId       String   @db.Uuid
  produtoId      String
  quantidade     Int
  precoUnitario  Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto        Produto  @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@index([produtoId])
}

model Perda {
  id          String      @id @default(cuid())
  produtoId   String
  usuarioId   String
  quantidade  Int
  motivo      MotivoPerda
  observacao  String?
  produto     Produto     @relation(fields: [produtoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([motivo])
  @@index([produtoId])
}

model Entrega {
  id             String        @id @default(uuid())
  pedidoId       String?       @unique @db.Uuid
  pedido         Pedido?       @relation(fields: [pedidoId], references: [id])
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  dataEntrega    DateTime
  horarioEntrega String
  endereco       String
  observacao     String?
  status         StatusEntrega @default(PENDENTE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("entregas")
}
